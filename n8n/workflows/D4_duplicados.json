      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Clave de negocio por tabla. productos.codigo y lotes_produccion.codigo ya son UNIQUE\n-- (control preventivo); clientes.correo no tiene restriccion.\nSELECT 'clientes' AS tabla, correo AS clave, count(*) AS veces\nFROM clientes WHERE correo IS NOT NULL GROUP BY correo HAVING count(*) > 1\nUNION ALL\nSELECT 'productos', codigo, count(*) FROM productos GROUP BY codigo HAVING count(*) > 1\nUNION ALL\nSELECT 'lotes_produccion', codigo, count(*) FROM lotes_produccion GROUP BY codigo HAVING count(*) > 1;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "nutriPgTi01",
          "name": "Postgres ti_db"
        }
      }
    },
    {
      "id": "d4-3",
      "name": "Construir alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Duplicados = suma de (veces - 1). Alerta si pasa de 5.\nconst filas = $input.all().map(i => i.json).filter(r => r.tabla);\nconst total = filas.reduce((s, r) => s + Number(r.veces) - 1, 0);\nif (total <= 5) return [];\nconst lista = filas.slice(0, 10).map(r => `- ${r.tabla}: ${r.clave} (${r.veces} veces)`).join('\\n');\nreturn [{ json: {\n  codigo: 'D4', categoria: 'Datos', severidad: 'ADVERTENCIA',\n  titulo: 'Duplicados en tablas críticas',\n  detalle: esc(`Registros duplicados: ${total} (umbral: 5)\\n${lista}`),\n  accion: esc('Revisar el origen de los registros (auditoria_datos, operacion = INSERT), depurar duplicados y evaluar una restricción UNIQUE.'),\n  dedup_key: `D4:${total}`, dedup_minutos: '60'\n}}];"
      }
    },
