    {
      "id": "d2-3",
      "name": "Construir alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Guarda una foto por minuto (solo con el flujo ACTIVO) y compara contra la mas\n// vieja de los ultimos 30 minutos. Alerta si crecio mas de 20% (tablas con >= 50 filas).\nconst VENTANA = 30 * 60 * 1000, UMBRAL = 1.2, MINIMO = 50;\nconst estado = $getWorkflowStaticData('global');\nconst t = Date.now();\nconst foto = {};\nfor (const { json: r } of $input.all()) foto[r.tabla] = Number(r.filas);\nconst hist = (estado.hist || []).filter(h => t - h.t <= VENTANA);\nconst base = hist[0];\nhist.push({ t, foto });\nestado.hist = hist;\nif (!base) return [];\nconst min = Math.round((t - base.t) / 60000);\nconst out = [];\nfor (const [tabla, filas] of Object.entries(foto)) {\n  const antes = base.foto[tabla];\n  if (antes === undefined || antes < MINIMO || filas <= antes * UMBRAL) continue;\n  const pct = Math.round((filas / antes - 1) * 100);\n  out.push({ json: {\n    codigo: 'D2', categoria: 'Datos', severidad: 'ADVERTENCIA',\n    titulo: 'Crecimiento anormal de tabla',\n    detalle: esc(`Tabla: ${tabla}\\nFilas hace ${min} min: ${antes}\\nFilas ahora: ${filas}\\nCrecimiento: ${pct}% (umbral: 20% en 30 min)`),\n    accion: esc(`Revisar los INSERT recientes en ${tabla} (pg_stat_statements y auditoria_datos) y confirmar si es una carga legítima.`),\n    dedup_key: `D2:${tabla}`, dedup_minutos: '30'\n  }});\n}\nreturn out;"
      }
    },
