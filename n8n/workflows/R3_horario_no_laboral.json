      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT pid, usename, client_addr, application_name,\n       backend_start AT TIME ZONE 'America/Costa_Rica' AS inicio_cr\nFROM pg_stat_activity\nWHERE backend_type = 'client backend'\n  AND usename <> 'ti_db'\n  AND (extract(hour FROM backend_start AT TIME ZONE 'America/Costa_Rica') >= $1::int\n       OR extract(hour FROM backend_start AT TIME ZONE 'America/Costa_Rica') < $2::int);",
        "options": {
          "queryReplacement": "={{ [$json.hora_inicio, $json.hora_fin] }}"
