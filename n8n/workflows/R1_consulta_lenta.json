      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.queryid, r.rolname AS usuario, s.calls,\n       round(s.max_exec_time) AS max_ms, round(s.mean_exec_time) AS prom_ms,\n       left(s.query, 200) AS query\nFROM pg_stat_statements s\nJOIN pg_roles r ON r.oid = s.userid\nWHERE s.max_exec_time > 1000\n  AND s.query NOT ILIKE '%pg_stat_%'\nORDER BY s.max_exec_time DESC LIMIT 5;",
