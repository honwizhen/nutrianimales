      ],
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Una alerta por parametro desviado\nreturn $input.all().map(i => i.json).filter(r => r.parametro).map(r => ({ json: {\n  codigo: 'H5', categoria: 'Hardening', severidad: 'CRITICA',\n  titulo: 'Configuración de seguridad distinta al baseline',\n  detalle: esc(`Parámetro: ${r.parametro}\\nValor esperado: ${r.valor_esperado}\\nValor actual: ${r.valor_actual}\\nFuente: pg_settings vs pg_settings_baseline`),\n  accion: esc(String(r.parametro).startsWith('pg_hba')\n    ? 'Restaurar pg_hba.conf (git checkout postgres/conf/pg_hba.conf), recargar con SELECT pg_reload_conf(); y verificar quién hizo el cambio.'\n    : `Revertir: ALTER SYSTEM RESET ${r.parametro}; SELECT pg_reload_conf(); y verificar quién hizo el cambio.`),\n  dedup_key: `H5:${r.parametro}=${r.valor_actual}`, dedup_minutos: '60'\n}}));"
      }
    },
