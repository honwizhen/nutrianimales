    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT md5(string_agg(name || '=' || setting, ',' ORDER BY name)) AS hash,\n       json_object_agg(name, setting) AS valores\nFROM pg_settings\nWHERE source IN ('default', 'configuration file', 'command line', 'environment variable');",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -176,
        0
      ],
      "id": "dbac01ec-4254-4880-9e8f-ecce1856b232",
      "name": "Consultar parámetros",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "nutriPgTi01",
          "name": "Postgres ti_db"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nconst actual = $input.first().json;\nconst hashActual = actual.hash;\nconst valoresActual = actual.valores;\n\nif (!data.hash) {\n  data.hash = hashActual;\n  data.valores = valoresActual;\n  return [{ json: { cambio: false, detalle: 'Primera ejecucion: hash guardado' } }];\n}\n\nif (data.hash === hashActual) {\n  return [{ json: { cambio: false, detalle: 'Sin cambios' } }];\n}\n\nconst cambios = [];\nconst antes = data.valores || {};\nfor (const k of Object.keys(valoresActual)) {\n  if (antes[k] !== valoresActual[k]) {\n    cambios.push(k + ': ' + antes[k] + ' -> ' + valoresActual[k]);\n  }\n}\n\ndata.hash = hashActual;\ndata.valores = valoresActual;\n\nreturn [{ json: { cambio: true, detalle: cambios.join('\\n') || 'Hash distinto', hash: hashActual } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
