      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- 03-seed.sql usa estado = 'exitoso' (no 'ok'). Devuelve 1 fila solo si hay que alertar.\nSELECT to_char(max(fecha), 'YYYY-MM-DD HH24:MI:SS') AS ultimo_backup,\n       round(extract(epoch FROM now() - max(fecha)) / 3600) AS horas\nFROM backups\nWHERE estado IN ('exitoso', 'ok')\nHAVING max(fecha) IS NULL OR max(fecha) < now() - interval '24 hours';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "nutriPgTi01",
          "name": "Postgres ti_db"
        }
      }
    },
    {
      "id": "d3-3",
      "name": "Construir alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// La consulta devuelve 1 fila solo cuando el ultimo respaldo exitoso tiene mas de 24 h\nconst r = $input.first()?.json;\nif (!r || (r.ultimo_backup === undefined && r.horas === undefined)) return [];\nreturn [{ json: {\n  codigo: 'D3', categoria: 'Datos', severidad: 'ADVERTENCIA',\n  titulo: 'Backup obsoleto - sin respaldo reciente',\n  detalle: esc(r.ultimo_backup ? `Último backup exitoso: ${r.ultimo_backup}\\nHoras sin respaldo: ${r.horas} (umbral: 24)` : 'No hay ningún backup exitoso registrado en la tabla backups'),\n  accion: esc('Ejecutar un respaldo (pg_dump) y registrarlo en la tabla backups con estado = exitoso.'),\n  dedup_key: 'D3', dedup_minutos: '360'\n}}];"
      }
    },
