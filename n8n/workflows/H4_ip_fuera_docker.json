        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- nutrianimales-net es 172.28.0.0/16. Socket local (client_addr nulo) no cuenta.\nSELECT pid, usename, host(client_addr) AS ip, application_name,\n       to_char(backend_start AT TIME ZONE 'America/Costa_Rica', 'YYYY-MM-DD HH24:MI:SS') AS inicio_cr\nFROM pg_stat_activity\nWHERE backend_type = 'client backend'\n  AND client_addr IS NOT NULL\n  AND NOT (client_addr << '172.28.0.0/16'::inet);",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "nutriPgTi01",
          "name": "Postgres ti_db"
        }
      }
    },
    {
      "id": "h4-3",
      "name": "Construir alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Una alerta por conexion sospechosa\nreturn $input.all().map(i => i.json).filter(r => r.pid).map(r => ({ json: {\n  codigo: 'H4', categoria: 'Hardening', severidad: 'CRITICA',\n  titulo: 'Conexión desde IP fuera de la red Docker',\n  detalle: esc(`IP origen: ${r.ip} (esperado: 172.28.0.0/16)\\nUsuario: ${r.usename}\\nPID: ${r.pid}\\nAplicación: ${r.application_name || '-'}\\nInicio: ${r.inicio_cr}`),\n  accion: esc(`Si no es legítima: SELECT pg_terminate_backend(${r.pid}); y revisar pg_hba.conf y las reglas UFW.`),\n  dedup_key: `H4:${r.pid}:${r.inicio_cr}`, dedup_minutos: '60'\n}}));"
      }
    },
