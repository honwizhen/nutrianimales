      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.queryid, s.userid, r.rolname AS usuario, s.calls, s.rows,\n       left(s.query, 200) AS query,\n       s.query !~* '\\mwhere\\M' AS sin_where\nFROM pg_stat_statements s\nJOIN pg_roles r ON r.oid = s.userid\nWHERE s.query ~* '^\\s*delete';",
        "options": {}
