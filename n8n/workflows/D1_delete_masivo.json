    {
      "id": "d1-3",
      "name": "Construir alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Metodo de deltas: pg_stat_statements acumula calls y rows desde el ultimo reset.\n// Se compara contra la foto del minuto anterior (datos estaticos del flujo).\n// Los datos estaticos solo se guardan con el flujo ACTIVO (no en \"Probar manualmente\").\nconst umbral = 100;\nconst estado = $getWorkflowStaticData('global');\nconst antes = estado.foto || {};\nconst primera = !estado.foto;\nconst ahora = {};\nconst alertas = [];\nfor (const { json: q } of $input.all()) {\n  const calls = Number(q.calls), rows = Number(q.rows);   // bigint llega como texto\n  const k = `${q.queryid}:${q.userid}`;\n  ahora[k] = { calls, rows };\n  const p = antes[k] && antes[k].calls <= calls ? antes[k] : { calls: 0, rows: 0 };  // calls bajo = reset\n  const dCalls = calls - p.calls, dRows = rows - p.rows;\n  if (primera || dCalls <= 0 || dRows / dCalls <= umbral) continue;\n  const filas = Math.round(dRows / dCalls);\n  const tabla = ((q.query || '').match(/delete\\s+from\\s+(?:only\\s+)?([\\w.\\\"]+)/i) || [])[1] || 'desconocida';\n  alertas.push({ json: {\n    codigo: 'D1', categoria: 'Datos', severidad: 'CRITICA',\n    titulo: q.sin_where ? 'DELETE masivo sin WHERE detectado' : 'DELETE masivo detectado',\n    detalle: esc(`Tabla: ${tabla}\\nFilas eliminadas: ${filas} (umbral: ${umbral})\\nTenía WHERE: ${q.sin_where ? 'NO' : 'sí'}\\nQuery: ${q.query}\\nUsuario: ${q.usuario}`),\n    accion: esc('Verificar intención. Consultar auditoria_datos (operacion = DELETE) para recuperar valor_antes.'),\n    dedup_key: `D1:${q.queryid}:${calls}`, dedup_minutos: '60'\n  }});\n}\nestado.foto = ahora;\nreturn alertas;\n"
      }
    },
