# Copie este archivo a .env y reemplace TODOS los valores.
# .env nunca se sube al repositorio (esta en .gitignore) y debe quedar con chmod 600.

# --- PostgreSQL ---
POSTGRES_DB=nutrianimales_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
AGENTE_IA_PASSWORD=change_me_agente_ia

# --- N8N ---
# Genere con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me_32_bytes_hex

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin

# --- Integraciones ---
GROQ_API_KEY=gsk_example_not_a_real_key
TELEGRAM_BOT_TOKEN=000000000:example_not_a_real_token
TELEGRAM_CHAT_ID=0
