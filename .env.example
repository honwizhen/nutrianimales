# Copie este archivo a .env y reemplace TODOS los valores.
# .env nunca se sube al repositorio (esta en .gitignore) y debe quedar con chmod 600.
# scripts/setup.sh genera contrasenas aleatorias para los valores change_me.

# --- PostgreSQL ---
POSTGRES_DB=nutrianimales_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- Usuarios de BD (hardening 7 y RBAC) ---
AGENTE_IA_PASSWORD=change_me
GERENTE_DB_PASSWORD=change_me
TI_DB_PASSWORD=change_me
AUDITOR_DB_PASSWORD=change_me

# --- N8N ---
N8N_ENCRYPTION_KEY=change_me

# --- pgAdmin ---
PGADMIN_EMAIL=admin@nutrianimales.com
PGADMIN_PASSWORD=change_me

# --- Integraciones (reemplazar a mano) ---
GROQ_API_KEY=gsk_example_not_a_real_key
TELEGRAM_BOT_TOKEN=000000000:example_not_a_real_token
TELEGRAM_CHAT_ID=0
